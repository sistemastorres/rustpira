// Settings window (design §5.7). Rust fills every property from the saved
// configuration, reads them back on "Guardar" and validates
// (`settings::form`). Created when opened, destroyed when closed.

import {
    Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, Switch,
    TabWidget, TextEdit,
} from "std-widgets.slint";

export struct SlotRow {
    start: string,
    end: string,
}

export struct DayRow {
    name: string,
    enabled: bool,
    slots: [SlotRow],
}

// Small square button that shows a drawn icon (its children). Drawn with
// paths so it does not depend on the font having the symbol.
component IconButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    background: touch.pressed ? Palette.alternate-background.darker(0.08)
        : touch.has-hover && root.enabled ? Palette.alternate-background
        : Palette.control-background;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    @children
}

component PlusIcon inherits Path {
    x: 8px;
    y: 8px;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 6 1 L 6 11 M 1 6 L 11 6";
    stroke: Palette.control-foreground;
    stroke-width: 1.6px;
}

component CrossIcon inherits Path {
    x: 9px;
    y: 9px;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
    stroke: Palette.control-foreground;
    stroke-width: 1.6px;
}

// Two overlapping sheets, the usual "copy" icon.
component CopyIcon inherits Path {
    x: 7px;
    y: 7px;
    width: 14px;
    height: 14px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: "M 4.5 4.5 L 12.5 4.5 L 12.5 12.5 L 4.5 12.5 Z M 1.5 9.5 L 1.5 1.5 L 9.5 1.5";
    stroke: Palette.control-foreground;
    stroke-width: 1.3px;
}

component ArrowButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> up;
    callback clicked();

    width: 18px;
    height: 14px;
    border-radius: 2px;
    background: touch.pressed ? Palette.alternate-background.darker(0.08)
        : touch.has-hover && root.enabled ? Palette.alternate-background
        : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.up ? "Subir 15 minutos" : "Bajar 15 minutos";

    Path {
        x: 5px;
        y: 4px;
        width: 8px;
        height: 6px;
        viewbox-width: 8;
        viewbox-height: 6;
        commands: root.up ? "M 0 6 L 4 0 L 8 6 Z" : "M 0 0 L 8 0 L 4 6 Z";
        fill: Palette.control-foreground;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A time as text plus up/down arrows that move it by 15 minutes.
component TimeField inherits HorizontalLayout {
    in property <string> text;
    in property <bool> enabled: true;
    callback edited(string);
    callback step(bool); // true = up

    spacing: 2px;
    LineEdit {
        width: 72px;
        enabled: root.enabled;
        text: root.text;
        edited(text) => { root.edited(text); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        ArrowButton {
            up: true;
            enabled: root.enabled;
            clicked => { root.step(true); }
        }
        ArrowButton {
            up: false;
            enabled: root.enabled;
            clicked => { root.step(false); }
        }
    }
}

component Label inherits Text {
    vertical-alignment: center;
    min-width: 200px;
}

component Hint inherits Text {
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.65);
    wrap: word-wrap;
}

export component Settings inherits Window {
    // General
    in-out property <int> interval-minutes;
    in-out property <int> break-minutes;
    in-out property <int> notice-index; // 0 = bloqueo, 1 = notificación
    in-out property <bool> start-with-windows;
    // Mensaje
    in-out property <string> heading;
    in-out property <string> message;
    // Horarios
    in property <[DayRow]> days;
    // Descanso
    in-out property <bool> allow-cancel;
    in-out property <bool> limit-cancels;
    in-out property <int> cancel-limit;
    in-out property <int> postpone-minutes;
    in-out property <int> max-postpones;
    in-out property <bool> idle-enabled;
    in-out property <int> idle-minutes;
    // Apariencia
    in-out property <int> background-index; // 0 = color, 1 = imagen
    in-out property <string> color-text;
    in property <color> color-preview;
    in-out property <string> image-path;
    in-out property <float> layer-opacity;
    in-out property <int> theme-index; // 0 = claro, 1 = oscuro
    // Sonido
    in property <[string]> sound-names;
    in-out property <int> sound-index;
    in property <int> custom-sound-index;
    in-out property <string> custom-sound-path;
    in-out property <float> volume;
    in-out property <bool> end-sound;
    // Footer
    in property <string> error;

    callback save();
    callback cancel();
    callback test-sound();
    callback pick-image();
    callback pick-sound();
    callback pick-color();
    callback color-edited(string);
    callback add-slot(int);
    callback remove-slot(int, int);
    callback copy-to-weekdays(int);
    callback start-edited(int, int, string);
    callback end-edited(int, int, string);
    callback step-time(int, int, bool, bool); // day, slot, start?, up?
    callback day-toggled(int, bool);

    title: "Rustpira - Configuración";
    icon: @image-url("../recursos/rustpira-256.png");
    preferred-width: 680px;
    preferred-height: 600px;
    min-width: 560px;
    min-height: 480px;

    init => {
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.dark : ColorScheme.light;
    }
    changed theme-index => {
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "General";
                VerticalLayout {
                    alignment: start;
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        Label { text: "Intervalo entre descansos (min)"; }
                        SpinBox {
                            minimum: 1;
                            maximum: 240;
                            value <=> root.interval-minutes;
                        }
                    }
                    HorizontalLayout {
                        Label { text: "Duración del descanso (min)"; }
                        SpinBox {
                            minimum: 1;
                            maximum: 60;
                            value <=> root.break-minutes;
                        }
                    }
                    HorizontalLayout {
                        Label { text: "Tipo de aviso"; }
                        ComboBox {
                            model: ["Pantalla completa (bloquea todo)", "Solo notificación"];
                            current-index <=> root.notice-index;
                        }
                    }
                    CheckBox {
                        text: "Iniciar con Windows";
                        checked <=> root.start-with-windows;
                    }
                }
            }

            Tab {
                title: "Mensaje";
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Título"; }
                    LineEdit { text <=> root.heading; }
                    Text { text: "Mensaje"; }
                    TextEdit {
                        text <=> root.message;
                        vertical-stretch: 1;
                    }
                    Hint { text: "Cada línea del mensaje se muestra en un renglón aparte."; }
                }
            }

            Tab {
                title: "Horarios";
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Hint {
                        text: "El interruptor habilita o deshabilita el día sin borrar sus franjas. + agrega una franja, × la quita y el botón de copiar pasa las franjas del día a todos los días hábiles. Las flechas mueven la hora de a 15 minutos.";
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-right: 12px;
                            spacing: 10px;
                            for day[d] in root.days: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Switch {
                                        checked: day.enabled;
                                        toggled => { root.day-toggled(d, self.checked); }
                                    }
                                    Text {
                                        text: day.name;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        min-width: 90px;
                                        color: day.enabled ? Palette.foreground : Palette.foreground.with-alpha(0.5);
                                    }
                                    IconButton {
                                        label: "Agregar franja";
                                        enabled: day.enabled;
                                        clicked => { root.add-slot(d); }
                                        PlusIcon { }
                                    }
                                    IconButton {
                                        label: "Copiar a todos los días hábiles";
                                        enabled: day.enabled;
                                        clicked => { root.copy-to-weekdays(d); }
                                        CopyIcon { }
                                    }
                                }
                                if !day.enabled || day.slots.length == 0: HorizontalLayout {
                                    padding-left: 52px;
                                    Hint {
                                        text: !day.enabled ? "Día deshabilitado: no hay avisos."
                                            : "Sin franjas: no hay avisos este día.";
                                    }
                                }
                                for slot[s] in day.slots: HorizontalLayout {
                                    spacing: 8px;
                                    padding-left: 52px;
                                    alignment: start;
                                    TimeField {
                                        enabled: day.enabled;
                                        text: slot.start;
                                        edited(text) => { root.start-edited(d, s, text); }
                                        step(up) => { root.step-time(d, s, true, up); }
                                    }
                                    Text { text: "a"; vertical-alignment: center; }
                                    TimeField {
                                        enabled: day.enabled;
                                        text: slot.end;
                                        edited(text) => { root.end-edited(d, s, text); }
                                        step(up) => { root.step-time(d, s, false, up); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            label: "Quitar franja";
                                            enabled: day.enabled;
                                            clicked => { root.remove-slot(d, s); }
                                            CrossIcon { }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Descanso";
                VerticalLayout {
                    alignment: start;
                    padding: 16px;
                    spacing: 12px;
                    CheckBox {
                        text: "Permitir cancelar el descanso";
                        checked <=> root.allow-cancel;
                    }
                    CheckBox {
                        text: "Limitar las cancelaciones seguidas";
                        enabled: root.allow-cancel;
                        checked <=> root.limit-cancels;
                    }
                    HorizontalLayout {
                        Label { text: "Cancelaciones seguidas permitidas"; }
                        SpinBox {
                            enabled: root.allow-cancel && root.limit-cancels;
                            minimum: 1;
                            maximum: 10;
                            value <=> root.cancel-limit;
                        }
                    }
                    Hint {
                        text: "Al llegar al límite, el próximo descanso es obligatorio: se muestra sin botones hasta que termina.";
                    }
                    HorizontalLayout {
                        Label { text: "Posponer (min)"; }
                        SpinBox {
                            minimum: 1;
                            maximum: 30;
                            value <=> root.postpone-minutes;
                        }
                    }
                    HorizontalLayout {
                        Label { text: "Posponer hasta (veces por descanso)"; }
                        SpinBox {
                            minimum: 0;
                            maximum: 3;
                            value <=> root.max-postpones;
                        }
                    }
                    CheckBox {
                        text: "Pausar el contador por inactividad";
                        checked <=> root.idle-enabled;
                    }
                    HorizontalLayout {
                        Label { text: "Minutos sin actividad"; }
                        SpinBox {
                            enabled: root.idle-enabled;
                            minimum: 1;
                            maximum: 120;
                            value <=> root.idle-minutes;
                        }
                    }
                    Hint {
                        text: "Si no usa el teclado ni el mouse durante ese tiempo, el contador se detiene y vuelve a empezar al detectar actividad. No puede superar el intervalo entre descansos.";
                    }
                }
            }

            Tab {
                title: "Apariencia";
                VerticalLayout {
                    alignment: start;
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        Label { text: "Fondo del descanso"; }
                        ComboBox {
                            model: ["Color", "Imagen"];
                            current-index <=> root.background-index;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Color"; }
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Palette.border;
                            background: root.color-preview;
                        }
                        LineEdit {
                            width: 110px;
                            text <=> root.color-text;
                            edited(text) => { root.color-edited(text); }
                        }
                        Button {
                            text: "Elegir…";
                            clicked => { root.pick-color(); }
                        }
                    }
                    Hint { text: "El color también se usa si la imagen no se puede cargar."; }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Imagen (PNG o JPG)"; }
                        LineEdit {
                            enabled: root.background-index == 1;
                            text <=> root.image-path;
                        }
                        Button {
                            enabled: root.background-index == 1;
                            text: "Examinar…";
                            clicked => { root.pick-image(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Opacidad"; }
                        Slider {
                            minimum: 0;
                            maximum: 100;
                            step: 1;
                            value <=> root.layer-opacity;
                        }
                        Text {
                            text: "\{Math.round(root.layer-opacity)} %";
                            vertical-alignment: center;
                            min-width: 48px;
                        }
                    }
                    HorizontalLayout {
                        Label { text: "Tema de esta ventana"; }
                        ComboBox {
                            model: ["Claro", "Oscuro"];
                            current-index <=> root.theme-index;
                        }
                    }
                }
            }

            Tab {
                title: "Sonido";
                VerticalLayout {
                    alignment: start;
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        Label { text: "Sonido"; }
                        ComboBox {
                            model: root.sound-names;
                            current-index <=> root.sound-index;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Archivo propio (.wav)"; }
                        LineEdit {
                            enabled: root.sound-index == root.custom-sound-index;
                            text <=> root.custom-sound-path;
                        }
                        Button {
                            enabled: root.sound-index == root.custom-sound-index;
                            text: "Examinar…";
                            clicked => { root.pick-sound(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Volumen"; }
                        Slider {
                            minimum: 0;
                            maximum: 100;
                            step: 1;
                            value <=> root.volume;
                        }
                        Text {
                            text: "\{Math.round(root.volume)} %";
                            vertical-alignment: center;
                            min-width: 48px;
                        }
                    }
                    CheckBox {
                        text: "Sonar también al terminar el descanso";
                        checked <=> root.end-sound;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Probar";
                            clicked => { root.test-sound(); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.error;
                color: #c42b1c;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Guardar";
                primary: true;
                clicked => { root.save(); }
            }
            Button {
                text: "Cancelar";
                clicked => { root.cancel(); }
            }
        }
    }
}
