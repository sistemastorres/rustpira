// Break screen (design §5.3). One instance per monitor; only the one on the
// primary monitor shows the content. Color or image share one opacity.

// Pill-shaped button for the break screen (S26): larger text, a solid
// white fill for the main action and a translucent outline for the other.
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> main: false;
    callback clicked();

    min-width: 220px;
    height: 54px;
    border-radius: self.height / 2;
    border-width: root.main ? 0px : 2px;
    border-color: #ffffffb3;
    background: root.main
        ? (touch.pressed ? #ffffffbf : touch.has-hover ? #ffffffe6 : #ffffff)
        : (touch.pressed ? #ffffff4d : touch.has-hover ? #ffffff33 : #ffffff1a);
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        Text {
            text: root.text;
            font-size: 19px;
            font-weight: 600;
            color: root.main ? #1f2937 : white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BreakOverlay inherits Window {
    in property <bool> primary: false;
    in property <color> bg-color: #1e3a5f;
    in property <image> bg-image;
    in property <bool> show-image: false;
    in property <float> layer-opacity: 0.8;
    in property <string> heading;
    in property <string> message;
    in property <string> countdown: "05:00";
    // Share of the break still ahead, 1.0 down to 0.0.
    in property <float> progress: 1.0;
    in property <bool> hard: false;
    in property <bool> can-cancel: false;
    in property <bool> can-postpone: false;
    // "Terminar descanso" replaces "Cancelar" late in the break (S25).
    in property <bool> can-finish: false;
    in property <string> postpone-label;

    callback cancel();
    callback postpone();
    callback finish();

    title: "Rustpira - descanso";
    icon: @image-url("../recursos/rustpira-256.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;

    if !root.show-image: Rectangle {
        background: root.bg-color.with-alpha(root.layer-opacity);
    }
    if root.show-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.bg-image;
        image-fit: cover;
        opacity: root.layer-opacity;
    }

    if root.primary: VerticalLayout {
        alignment: center;
        padding: 40px;

        HorizontalLayout {
            alignment: center;

            // Rounded frame around the whole message (S23).
            Rectangle {
                width: min(760px, root.width - 80px);
                border-radius: 24px;
                background: #00000059;
                border-width: 1px;
                border-color: #ffffff40;

                VerticalLayout {
                    padding: 40px;
                    spacing: 18px;

                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../recursos/rustpira-256.png");
                            width: 128px;
                            height: 128px;
                        }
                    }
                    Text {
                        text: root.heading;
                        font-size: 44px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.message;
                        font-size: 22px;
                        color: white;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.countdown;
                        font-size: 80px;
                        font-weight: 300;
                        color: white;
                        horizontal-alignment: center;
                    }
                    // Descending progress bar: full at the start, empty at the end.
                    Rectangle {
                        height: 10px;
                        border-radius: 5px;
                        background: #ffffff33;
                        accessible-role: progress-indicator;
                        accessible-value: Math.round(root.progress * 100) + " %";

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * max(0, min(1, root.progress));
                            height: parent.height;
                            border-radius: 5px;
                            background: white;
                            animate width {
                                duration: 1s;
                                easing: linear;
                            }
                        }
                    }
                    if root.hard: Text {
                        text: "Descanso obligatorio: no se puede cancelar ni posponer.";
                        font-size: 16px;
                        color: #ffffffcc;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 16px;
                        if root.can-postpone: PillButton {
                            text: root.postpone-label;
                            clicked => { root.postpone(); }
                        }
                        if root.can-cancel: PillButton {
                            text: "Cancelar descanso";
                            main: true;
                            clicked => { root.cancel(); }
                        }
                        if root.can-finish: PillButton {
                            text: "Terminar descanso";
                            main: true;
                            clicked => { root.finish(); }
                        }
                    }
                }
            }
        }
    }
}
